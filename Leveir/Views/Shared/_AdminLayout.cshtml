<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />

    <link rel="stylesheet"
          href="https://site-assets.fontawesome.com/releases/v6.7.2/css/all.css">
    <link href="~/Content/Admin_assets/libs/datatables.net-bs5/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <link href="~/Content/Admin_assets/libs/datatables.net-buttons-bs5/css/buttons.bootstrap5.min.css" rel="stylesheet" />
    <link href="~/Content/Admin_assets/libs/datatables.net-keytable-bs5/css/keyTable.bootstrap5.min.css" rel="stylesheet" />
    <link href="~/Content/Admin_assets/libs/datatables.net-responsive-bs5/css/responsive.bootstrap5.min.css" rel="stylesheet" />
    <link href="~/Content/Admin_assets/libs/datatables.net-select-bs5/css/select.bootstrap5.min.css" rel="stylesheet" />

    <!-- App favicon -->
    <link rel="shortcut icon" href="assets/images/favicon.ico">

    <!-- App css -->
    <link href="~/Content/Admin_assets/css/app.min.css" rel="stylesheet" />

    <!-- Icons -->
    <link href="~/Content/Admin_assets/css/icons.min.css" rel="stylesheet" />
    <title>@ViewBag.Title - Leveir</title>
</head>
<body>
    <div id="app-layout">
        <!--Header Start Here-->
        <div class="topbar-custom">
            <div class="container-xxl">
                <div class="d-flex justify-content-between">
                    <ul class="list-unstyled topnav-menu mb-0 d-flex align-items-center">
                        <li>
                            <button class="button-toggle-menu nav-link ps-0">
                                <i data-feather="menu" class="noti-icon"></i>
                            </button>
                        </li>
                        <li class="d-none d-lg-block">
                            <div class="position-relative topbar-search">
                                <input type="text" class="form-control bg-light bg-opacity-75 border-light ps-4" placeholder="Search...">
                                <i class="mdi mdi-magnify fs-16 position-absolute text-muted top-50 translate-middle-y ms-2"></i>
                            </div>
                        </li>
                    </ul>

                    <ul class="list-unstyled topnav-menu mb-0 d-flex align-items-center">

                        <li class="d-none d-sm-flex">
                            <button type="button" class="btn nav-link" data-toggle="fullscreen">
                                <i data-feather="maximize" class="align-middle fullscreen noti-icon"></i>
                            </button>
                        </li>

                        <li class="dropdown notification-list topbar-dropdown">
                            <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="false" aria-expanded="false">
                                <i data-feather="bell" class="noti-icon"></i>
                                <span class="badge bg-danger rounded-circle noti-icon-badge">9</span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end dropdown-lg">

                                <!-- item-->
                                <div class="dropdown-item noti-title">
                                    <h5 class="m-0">
                                        <span class="float-end">
                                            <a href="#" class="text-dark">
                                                <small>Clear All</small>
                                            </a>
                                        </span>Notification
                                    </h5>
                                </div>

                                <div class="noti-scroll" data-simplebar>

                                    <!-- item-->
                                    <a href="javascript:void(0);" class="dropdown-item notify-item text-muted link-primary active">
                                        <div class="notify-icon">
                                            <img src="~/Content/Admin_assets/images/users/user-12.jpg" class="img-fluid rounded-circle" alt="" />

                                        </div>
                                        <div class="d-flex align-items-center justify-content-between">
                                            <p class="notify-details">Carl Steadham</p>
                                            <small class="text-muted">5 min ago</small>
                                        </div>
                                        <p class="mb-0 user-msg">
                                            <small class="fs-14">Completed <span class="text-reset">Improve workflow in Figma</span></small>
                                        </p>
                                    </a>

                                    <!-- item-->
                                    <a href="javascript:void(0);" class="dropdown-item notify-item text-muted link-primary">
                                        <div class="notify-icon">
                                            <img src="~/Content/Admin_assets/images/users/user-2.jpg" class="img-fluid rounded-circle" alt="" />
                                        </div>
                                        <div class="notify-content">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <p class="notify-details">Olivia McGuire</p>
                                                <small class="text-muted">1 min ago</small>
                                            </div>

                                            <div class="d-flex mt-2 align-items-center">
                                                <div class="notify-sub-icon">
                                                    <i class="mdi mdi-download-box text-dark"></i>
                                                </div>

                                                <div>
                                                    <p class="notify-details mb-0">dark-themes.zip</p>
                                                    <small class="text-muted">2.4 MB</small>
                                                </div>
                                            </div>

                                        </div>
                                    </a>

                                    <!-- item-->
                                    <a href="javascript:void(0);" class="dropdown-item notify-item text-muted link-primary">
                                        <div class="notify-icon">
                                            <img src="~/Content/Admin_assets/images/users/user-3.jpg" class="img-fluid rounded-circle" alt="" />
                                        </div>
                                        <div class="notify-content">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <p class="notify-details">Travis Williams</p>
                                                <small class="text-muted">7 min ago</small>
                                            </div>
                                            <p class="noti-mentioned p-2 rounded-2 mb-0 mt-2"><span class="text-primary">@@Patryk</span> Please make sure that you're....</p>
                                        </div>
                                    </a>

                                    <!-- item-->
                                    <a href="javascript:void(0);" class="dropdown-item notify-item text-muted link-primary">
                                        <div class="notify-icon">
                                            <img src="~/Content/Admin_assets/images/users/user-8.jpg" class="img-fluid rounded-circle" alt="" />
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between">
                                            <p class="notify-details">Violette Lasky</p>
                                            <small class="text-muted">5 min ago</small>
                                        </div>
                                        <p class="mb-0 user-msg">
                                            <small class="fs-14">Completed <span class="text-reset">Create new components</span></small>
                                        </p>
                                    </a>

                                    <!-- item-->
                                    <a href="javascript:void(0);" class="dropdown-item notify-item text-muted link-primary">
                                        <div class="notify-icon">
                                            <img src="~/Content/Admin_assets/images/users/user-5.jpg" class="img-fluid rounded-circle" alt="" />
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between">
                                            <p class="notify-details">Ralph Edwards</p>
                                            <small class="text-muted">5 min ago</small>
                                        </div>
                                        <p class="mb-0 user-msg">
                                            <small class="fs-14">Completed <span class="text-reset">Improve workflow in React</span></small>
                                        </p>
                                    </a>

                                    <!-- item-->
                                    <a href="javascript:void(0);" class="dropdown-item notify-item text-muted link-primary">
                                        <div class="notify-icon">
                                            <img src="~/Content/Admin_assets/images/users/user-6.jpg" class="img-fluid rounded-circle" alt="" />
                                        </div>
                                        <div class="notify-content">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <p class="notify-details">Jocab jones</p>
                                                <small class="text-muted">7 min ago</small>
                                            </div>
                                            <p class="noti-mentioned p-2 rounded-2 mb-0 mt-2"><span class="text-reset">@@Patryk</span> Please make sure that you're....</p>
                                        </div>
                                    </a>
                                </div>

                                <!-- All-->
                                <a href="javascript:void(0);" class="dropdown-item text-center text-primary notify-item notify-all">
                                    View all
                                    <i class="fe-arrow-right"></i>
                                </a>

                            </div>
                        </li>

                        <li class="dropdown notification-list topbar-dropdown">
                            <a class="nav-link dropdown-toggle nav-user me-0" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="false" aria-expanded="false">
                                <img src="~/Content/Admin_assets/images/users/user-11.jpg" alt="user-image" class="rounded-circle">
                                <span class="pro-user-name ms-1">
                                    Christian <i class="mdi mdi-chevron-down"></i>
                                </span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end profile-dropdown ">
                                <!-- item-->
                                <div class="dropdown-header noti-title">
                                    <h6 class="text-overflow m-0">Welcome !</h6>
                                </div>

                                <!-- item-->
                                <a class='dropdown-item notify-item' href='pages-profile.html'>
                                    <i class="mdi mdi-account-circle-outline fs-16 align-middle"></i>
                                    <span>My Account</span>
                                </a>

                                <!-- item-->
                                <a class='dropdown-item notify-item' href='auth-lock-screen.html'>
                                    <i class="mdi mdi-lock-outline fs-16 align-middle"></i>
                                    <span>Lock Screen</span>
                                </a>

                                <div class="dropdown-divider"></div>

                                <!-- item-->

                                <a class='dropdown-item notify-item' href='@Url.Action("AdminLogout", "Account")'>
                                    <i class="mdi mdi-location-exit fs-16 align-middle"></i>
                                    <span>Logout</span>
                                </a>

                            </div>
                        </li>

                    </ul>
                </div>

            </div>

        </div>
        <!--Header End Here-->
        <!--Sidebar Start Here-->
        <div class="app-sidebar-menu">
            <div class="h-100" data-simplebar>

                <!--- Sidemenu -->
                <div id="sidebar-menu">

                    <div class="logo-box">
                        <a class='logo logo-light' href='@Url.Action("Dashboard", "Admin")'>
                            <span class="logo-sm">
                                <img src="~/Content/Admin_assets/images/Leveir-circle-logo.png" alt="" height="22">
                                <img src="~/Content/Admin_assets/images/Leveir-logo.png" alt="" height="22">
                            </span>
                            <span class="logo-lg">
                                <img src="~/Content/Admin_assets/images/Leveir-circle-logo.png" alt="" height="40" />
                                <img src="~/Content/Admin_assets/images/Leveir-logo.png" alt="" height="40">
                            </span>
                        </a>
                        <a class='logo logo-dark' href='index.html'>
                            <span class="logo-sm">
                                <img src="~/Content/Admin_assets/images/Leveir-circle-logo.png" alt="" height="22">
                                <img src="~/Content/Admin_assets/images/Leveir-logo.png" alt="" height="22">
                            </span>
                            <span class="logo-lg">
                                <img src="~/Content/Admin_assets/images/Leveir-circle-logo.png" alt="" height="45">
                                <img src="~/Content/Admin_assets/images/Leveir-logo.png" alt="" height="45">
                            </span>
                        </a>
                    </div>

                    <ul id="side-menu">

                        <li class="menu-title">Menu</li>

                        <li>
                            <a href="@Url.Action("Dashboard", "Admin")">
                                <i data-feather="home"></i>
                                <span> Dashboard </span>
                            </a>
                        </li>


                        <li class="menu-title">Jewelry Types</li>
                        <li>
                            <a href="@Url.Action("AddJewelryTypes", "Admin")">
                                <i data-feather="home"></i>
                                <span>Add Jewelry Types</span>
                            </a>
                        </li>

                        <li>
                            <a href="@Url.Action("JewelryTypeLists", "Admin")">
                                <i data-feather="home"></i>
                                <span>Jewelry Type Lists</span>
                            </a>
                        </li>

                        <li class="menu-title mt-2">Setting Styles</li>

                        <li>
                            <a href="@Url.Action("AddSettingStyle", "Admin")">
                                <i data-feather="home"></i>
                                <span>Add Setting Style</span>
                            </a>
                        </li>

                        <li>
                            <a href="@Url.Action("SettingStyleLists", "Admin")">
                                <i data-feather="home"></i>
                                <span>Setting Style Lists</span>
                            </a>
                        </li>

                        <li class="menu-title mt-2">Metals</li>

                        <li>
                            <a href="@Url.Action("AddMetals", "Admin")">
                                <i data-feather="home"></i>
                                <span>Add Metals</span>
                            </a>
                        </li>

                        <li>
                            <a href="@Url.Action("MetalLists", "Admin")">
                                <i data-feather="home"></i>
                                <span>Metal Lists</span>
                            </a>
                        </li>


                        <li class="menu-title mt-2">Diamonds</li>

                        <li>
                            <a href="@Url.Action("AddDiamondType", "Admin")">
                                <i data-feather="home"></i>
                                <span>Add Diamond Type</span>
                            </a>
                        </li>

                        <li>
                            <a href="@Url.Action("DiamondTypeLists", "Admin")">
                                <i data-feather="home"></i>
                                <span>Diamond Type Lists</span>
                            </a>
                        </li>

                        <li>
                            <a href="@Url.Action("AddDiamonds", "Admin")">
                                <i data-feather="home"></i>
                                <span>Add Diamonds</span>
                            </a>
                        </li>

                        <li>
                            <a href="@Url.Action("DiamondLists", "Admin")">
                                <i data-feather="home"></i>
                                <span>Diamond Lists</span>
                            </a>
                        </li>

                    </ul>

                </div>
                <!-- End Sidebar -->
                <div class="clearfix"></div>

            </div>
        </div>
        <!--Sidebar End Here-->

        @RenderBody()

        <!--Footer Start Here-->
        <footer class="footer">
            <div class="container-fluid">
                <div class="row">
                    <div class="col fs-13 text-muted text-center">
                        &copy;
                        <script>document.write(new Date().getFullYear())</script> Design & Developed by <a href="https://www.barrownz.com/" class="text-reset fw-semibold">Barrownz Group</a>
                    </div>
                </div>
            </div>
        </footer>
        <!--Footer End Here-->
    </div>

    <script src="~/Content/Admin_assets/libs/jquery/jquery.min.js"></script>
    <script src="~/Content/Admin_assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/Content/Admin_assets/libs/simplebar/simplebar.min.js"></script>
    <script src="~/Content/Admin_assets/libs/node-waves/waves.min.js"></script>
    <script src="~/Content/Admin_assets/libs/waypoints/lib/jquery.waypoints.min.js"></script>
    <script src="~/Content/Admin_assets/libs/jquery.counterup/jquery.counterup.min.js"></script>
    <script src="~/Content/Admin_assets/libs/feather-icons/feather.min.js"></script>

    <!-- Datatables js -->
    <script src="~/Content/Admin_assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>

    <!-- dataTables.bootstrap5 -->
    <script src="~/Content/Admin_assets/libs/datatables.net-bs5/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/Content/Admin_assets/libs/datatables.net-buttons/js/dataTables.buttons.min.js"></script>
    <!-- Datatable Demo App Js -->

    <script src="~/Content/Admin_assets/js/pages/datatable.init.js"></script>
    <!-- Apexcharts JS -->
    <script src="~/Content/Admin_assets/libs/apexcharts/apexcharts.min.js"></script>

    <!-- for basic area chart -->
    <script src="../../../apexcharts.com/samples/assets/stock-prices.js"></script>


    <!-- Widgets Init Js -->
    <script src="~/Content/Admin_assets/js/pages/analytics-dashboard.init.js"></script>
    <script src="~/Content/Admin_assets/js/pages/ecommerce-dashboard.init.js"></script>
    <!-- App js-->

    <script src="~/Content/Admin_assets/js/app.js"></script>
</body>
</html>
