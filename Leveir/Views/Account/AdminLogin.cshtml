
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <!-- App favicon -->
    <link rel="shortcut icon" href="assets/images/favicon.ico">
    <!-- App css -->
    <link href="~/Content/Admin_assets/css/app.min.css" rel="stylesheet" />
    <!-- Icons -->
    <link href="~/Content/Admin_assets/css/icons.min.css" rel="stylesheet" />
    <title>Admin-Login</title>
</head>
<body class="bg-white">
    <div class="account-page">
        <div class="container-fluid p-0">
            <div class="row align-items-center g-0">
                <div class="col-xl-5">
                    <div class="row">
                        <div class="col-md-7 mx-auto">
                            <div class="mb-0 border-0 p-md-5 p-lg-0 p-4">
                                <div class="mb-4 p-0">
                                    <a class='auth-logo' href='@Url.Action("AdminLogin", "Account")'>
                                        <img src="~/Content/Admin_assets/images/Leveir-circle-logo.png" class="mx-auto" height="35" />
                                        <img src="~/Content/Admin_assets/images/Leveir-logo.png" class="mx-auto" height="35" />
                                    </a>
                                </div>

                                <div class="pt-0">
                                    <form id="adminLoginForm" action="@Url.Action("AdminLogin", "Account")" method="post" class="my-4" novalidate>
                                        <div class="form-group mb-3">
                                            <label for="emailaddress" class="form-label">Email address</label>
                                            <input class="form-control" type="email" name="email" id="emailaddress" placeholder="Enter your email">
                                            <small class="text-danger d-none" id="emailError">Please enter a valid email address.</small>
                                        </div>

                                        <div class="form-group mb-3">
                                            <label for="password" class="form-label">Password</label>
                                            <input class="form-control" type="password" name="password" id="password" placeholder="Enter your password">
                                            <small class="text-danger d-none" id="passwordError">Password is required.</small>
                                        </div>

                                        <div class="form-group d-flex mb-3">
                                            <div class="col-sm-6">
                                                <div class="form-check">
                                                    <input type="checkbox" class="form-check-input" id="checkbox-signin" checked>
                                                    <label class="form-check-label" for="checkbox-signin">Remember me</label>
                                                </div>
                                            </div>
                                            <div class="col-sm-6 text-end">
                                                <a class='text-muted fs-14' href='#'>Forgot password?</a>
                                            </div>
                                        </div>

                                        <div class="form-group mb-0 row">
                                            <div class="col-12">
                                                <div class="d-grid">
                                                    <button class="btn btn-primary mb-2" type="submit"> Log In </button>
                                                </div>
                                            </div>
                                        </div>
                                    </form>
                                    @if (ViewBag.ErrorMessage != null)
                                    {
                                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                            @ViewBag.ErrorMessage
                                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                        </div>
                                    }

                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-7">
                    <div class="account-page-bg p-md-5 p-4">
                        <div class="text-center">
                            <h3 class="text-dark mb-3 pera-title">
                                Jewelry is the most transformative thing you can wear.
                            </h3>
                            <div class="auth-image">
                                <img src="~/Content/Admin_assets/images/authentication.svg" class="mx-auto" style="max-width: 80%; height: auto;" alt="images">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="~/Content/Admin_assets/js/ClinetSideValidation.js"></script>
    <script src="~/Content/Admin_assets/libs/jquery/jquery.min.js"></script>
    <script src="~/Content/Admin_assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
