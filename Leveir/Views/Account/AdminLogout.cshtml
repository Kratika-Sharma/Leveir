
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <!-- App css -->
    <link href="~/Content/Admin_assets/css/app.min.css" rel="stylesheet" />
    <!-- Icons -->
    <link href="~/Content/Admin_assets/css/icons.min.css" rel="stylesheet" />
    <title>AdminLogout</title>
</head>
<body class="bg-white">
    <!-- Begin page -->
    <div class="account-page">
        <div class="container-fluid p-0">
            <div class="row align-items-center g-0">
                <div class="col-md-5">
                    <div class="row">
                        <div class="col-md-7 mx-auto">
                            <div class="mb-0 border-0 p-md-5 p-lg-0 p-4">

                                <div class="mb-4 p-0 text-center">
                                    <a class='auth-logo' href='@Url.Action("AdminLogin", "Admin")'>
                                        <img src="~/Content/Admin_assets/images/Leveir-circle-logo.png" class="mx-auto" height="35" />
                                        <img src="~/Content/Admin_assets/images/Leveir-logo.png" class="mx-auto" height="35" />
                                    </a>
                                </div>

                                <div class="text-center auth-title-section">
                                    <h3 class="text-dark fs-20 fw-medium mb-2">You are Logged Out</h3>
                                    <p class="text-muted fs-15">Thank you for using Tapeli admin template</p>
                                </div>

                                <div class="text-center">
                                    <a class='btn btn-primary mt-3 me-1' href='@Url.Action("AdminLogin", "Account")'> Log In </a>
                                </div>

                                <div class="maintenance-img text-center pt-4">
                                    <img src="~/Content/Admin_assets/images/svg/logout.svg" height="200" alt="svg-logo">
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-7">
                    <div class="account-page-bg p-md-5 p-4">
                        <div class="text-center">
                            <h3 class="text-dark mb-3 pera-title">Quick, Effective, and Productive With Tapeli Admin Dashboard</h3>
                            <div class="auth-image">
                                <img src="~/Content/Admin_assets/images/authentication.svg"  style="max-width: 80%; height: auto;" class="mx-auto" alt="images">
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <!-- END wrapper -->
    <script src="~/Content/Admin_assets/libs/jquery/jquery.min.js"></script>
    <script src="~/Content/Admin_assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
