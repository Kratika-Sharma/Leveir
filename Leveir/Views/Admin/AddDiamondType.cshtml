
@{
    ViewBag.Title = "AddDiamondType";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<div class="content-page">
    <div class="content">
        <div class="container-xxl">
            <div class="py-3 d-flex align-items-sm-center flex-sm-row flex-column">
                <div class="flex-grow-1">
                    <h4 class="fs-18 fw-semibold m-0">Jewelry Types</h4>
                </div>
                <div class="text-end">
                    <ol class="breadcrumb m-0 py-0">
                        <li class="breadcrumb-item"><a href="">Jewelry Type Lists</a></li>
                    </ol>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-12">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Add Jewelry Types</h5>
                        </div>
                        <div class="card-body">
                            <form  action="@Url.Action("AddDiamondType", "Admin")" method="post" enctype="multipart/form-data" novalidate>
                                <div class="mb-3">
                                    <label for="DiamondTypeName" class="form-label">Diamond Type Name</label>
                                    <input type="text" class="form-control" placeholder="Enter Diamond Type" name="DiamondTypeName" />
                                  
                                </div>
                                <button type="submit" class="btn btn-primary">
                                    Submit
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>